# ===========================================================================
#  Environment variables TEMPLATE — copy to `.env` and fill values.
#  The real `.env` is git-ignored and must NEVER be committed.
# ===========================================================================

# --- Server ---
PORT=3100
NODE_ENV=development

# --- MySQL (XAMPP defaults: user=root, empty password, host=127.0.0.1) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=daftar_hesab_app

# --- Or one connection URL, which wins over the block above ---
# Managed providers (Railway, Render) hand out a single string; Railway also sets
# MYSQLUSER / MYSQLPASSWORD / MYSQLHOST / MYSQLPORT / MYSQLDATABASE, which the
# granular block above already reads. Set this only if you really have a URL.
# DATABASE_URL=mysql://user:password@host:3306/daftar_hesab_app

# --- TLS policy for MySQL (see server/config/db.js) ---
# Leave unset for localhost. Set `true` for managed providers (Render/PlanetScale).
# Set `insecure` ONLY in development if the provider uses a self-signed cert.
# Provide DB_SSL_CA=/path/to/ca.pem to verify against a specific CA.
# DB_SSL=true
# DB_SSL_CA=

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# --- Uploads (transaction attachments, check photos) ---
UPLOAD_DIR=./client/uploads
MAX_UPLOAD_MB=5

# --- Default locale (used when a new user has not chosen yet) ---
DEFAULT_LANG=fa
